proc TelSend[qState, qHBell](xMeasCh: chan bit, zMeasCh: chan bit) :=
  CNOT(qState, qHBell).
  H(qState).
  M01(qState > z).
  M01(qHBell > x).
  xMeasCh!x.
  zMeasCh!z.
  disc(qState, qHBell)

proc TelRecv[qHBell](xMeasCh: chan bit, zMeasCh: chan bit, outCh: chan qubit) :=
  xMeasCh?x.
  zMeasCh?z.
  (if x = 0 then I(qHBell) else X(qHBell)).
  (if z = 0 then I(qHBell) else Z(qHBell)).
  outCh!qHBell.
  disc()

proc Teleportation[qState, qHBell1, qHBell2](outCh: chan qubit) :=
  (@TelSend[qState, qHBell1](xch, zch) || @TelRecv[qHBell2](xch, zch, outCh)) \ xch \ zch

proc BellGenerator[q0, q1](out1: chan qubit, out2: chan qubit) :=
  SetPhiP(q0, q1).((out1!q0.disc()) || (out2!q1.disc()))

proc SpecStrong[qState, qHBell1, qHBell2](outCh: chan qubit) :=
  SWAP(qState, qHBell2).
  tau.
  tau.
  tau.
  tau.
  tau.
  tau.
  tau.
  outCh!qHBell2.
  disc(qState, qHBell1)

proc SpecWeak[qState, qHBell1, qHBell2](outCh: chan qubit) :=
  SWAP(qState, qHBell2).
  outCh!qHBell2.
  disc(qState, qHBell1)

state GHZ := density 2 H(0).CNOT(0,1)

state PreparedExample := density 3 H(0).H(1).CNOT(1,2)

start "example" {
  density PreparedExample
  process @Teleportation[qb0, qb1, qb2](outCh)
}

start "exampleSpecStrong" {
    density PreparedExample
    process @SpecStrong[qb0, qb1, qb2](outCh)
}

start "exampleSpecWeak" {
    density PreparedExample
    process @SpecWeak[qb0, qb1, qb2](outCh)
}
