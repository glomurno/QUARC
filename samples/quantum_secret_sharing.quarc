-- Quantum secret sharing with GHZ states (Hillery, Bužek, Berthiaume 1999),
-- single round. Alice (dealer) shares a random secret bit with the
-- receivers so that only all of them together can recover it.
--
-- Every party measures its qubit of the GHZ state in a random basis
-- (0 = X via MH, 1 = Y via MHI). The receivers release their measurement
-- results to each other in increasing order, then their bases (to each other
-- and to Alice) in decreasing order; Alice announces her basis last. The round
-- is kept iff an even number nY of Y measurements was made, and then
--   a = (xor of the receivers' results) ^ (nY / 2 mod 2)
-- so every receiver can reconstruct the secret a. Since nY is even,
-- nY / 2 mod 2 = C(nY, 2) mod 2, the xor of the pairwise ANDs of the bases.
--
-- Channels: rXY carries a result and bXY a basis from X to Y, where a is
-- Alice and 1, 2, 3 are the receivers.

-- Two receivers. Order of communication:
--   receiver 1 result, receiver 2 result, receiver 2 basis, receiver 1 basis.

proc QSSDealer[q](basisFrom1: chan bit, basisFrom2: chan bit, basisTo1: chan bit, basisTo2: chan bit, secret: chan bit) :=
  MRandBit(> y).
  (if y = 0 then MH(q > a) else MHI(q > a)).
  basisFrom2?y2.
  basisFrom1?y1.
  basisTo1!y.
  basisTo2!y.
  (if y ^ y1 ^ y2 = 0 then secret!a.disc(q) else disc(q))

proc QSSReceiver1[q](resTo2: chan bit, resFrom2: chan bit, basisFrom2: chan bit, basisTo2: chan bit, basisToDealer: chan bit, basisFromDealer: chan bit, secret: chan bit) :=
  MRandBit(> y).
  (if y = 0 then MH(q > m) else MHI(q > m)).
  resTo2!m.
  resFrom2?m2.
  basisFrom2?y2.
  basisTo2!y.
  basisToDealer!y.
  basisFromDealer?ya.
  (if ya ^ y ^ y2 = 0 then secret!m ^ m2 ^ (ya | y | y2).disc(q) else disc(q))

proc QSSReceiver2[q](resFrom1: chan bit, resTo1: chan bit, basisTo1: chan bit, basisFrom1: chan bit, basisToDealer: chan bit, basisFromDealer: chan bit, secret: chan bit) :=
  MRandBit(> y).
  (if y = 0 then MH(q > m) else MHI(q > m)).
  resFrom1?m1.
  resTo1!m.
  basisTo1!y.
  basisToDealer!y.
  basisFrom1?y1.
  basisFromDealer?ya.
  (if ya ^ y1 ^ y = 0 then secret!m1 ^ m ^ (ya | y1 | y).disc(q) else disc(q))

proc QSSSpec[qAlice, qR1, qR2](secret: chan bit, secret1: chan bit, secret2: chan bit) :=
  MRandBit(> s).MRandBit(> keep).
  (if keep = 0
    then disc(qAlice, qR1, qR2)
    else ((secret!s.disc()) || (secret1!s.disc()) || (secret2!s.disc()) || disc(qAlice, qR1, qR2)))

-- Three receivers. Order of communication:
--   results of receivers 1, 2, 3, then bases of receivers 3, 2, 1.

proc QSSDealer3[q](basisFrom1: chan bit, basisFrom2: chan bit, basisFrom3: chan bit, basisTo1: chan bit, basisTo2: chan bit, basisTo3: chan bit, secret: chan bit) :=
  MRandBit(> y).
  (if y = 0 then MH(q > a) else MHI(q > a)).
  basisFrom3?y3.
  basisFrom2?y2.
  basisFrom1?y1.
  basisTo1!y.
  basisTo2!y.
  basisTo3!y.
  (if y ^ y1 ^ y2 ^ y3 = 0 then secret!a.disc(q) else disc(q))

proc QSS3Receiver1[q](resTo2: chan bit, resTo3: chan bit, resFrom2: chan bit, resFrom3: chan bit, basisFrom3: chan bit, basisFrom2: chan bit, basisTo2: chan bit, basisTo3: chan bit, basisToDealer: chan bit, basisFromDealer: chan bit, secret: chan bit) :=
  MRandBit(> y).
  (if y = 0 then MH(q > m) else MHI(q > m)).
  resTo2!m.
  resTo3!m.
  resFrom2?m2.
  resFrom3?m3.
  basisFrom3?y3.
  basisFrom2?y2.
  basisTo2!y.
  basisTo3!y.
  basisToDealer!y.
  basisFromDealer?ya.
  (if ya ^ y ^ y2 ^ y3 = 0
    then secret!m ^ m2 ^ m3 ^ (ya & y ^ ya & y2 ^ ya & y3 ^ y & y2 ^ y & y3 ^ y2 & y3).disc(q)
    else disc(q))

proc QSS3Receiver2[q](resFrom1: chan bit, resTo1: chan bit, resTo3: chan bit, resFrom3: chan bit, basisFrom3: chan bit, basisTo1: chan bit, basisTo3: chan bit, basisToDealer: chan bit, basisFrom1: chan bit, basisFromDealer: chan bit, secret: chan bit) :=
  MRandBit(> y).
  (if y = 0 then MH(q > m) else MHI(q > m)).
  resFrom1?m1.
  resTo1!m.
  resTo3!m.
  resFrom3?m3.
  basisFrom3?y3.
  basisTo1!y.
  basisTo3!y.
  basisToDealer!y.
  basisFrom1?y1.
  basisFromDealer?ya.
  (if ya ^ y1 ^ y ^ y3 = 0
    then secret!m1 ^ m ^ m3 ^ (ya & y1 ^ ya & y ^ ya & y3 ^ y1 & y ^ y1 & y3 ^ y & y3).disc(q)
    else disc(q))

proc QSS3Receiver3[q](resFrom1: chan bit, resFrom2: chan bit, resTo1: chan bit, resTo2: chan bit, basisTo1: chan bit, basisTo2: chan bit, basisToDealer: chan bit, basisFrom2: chan bit, basisFrom1: chan bit, basisFromDealer: chan bit, secret: chan bit) :=
  MRandBit(> y).
  (if y = 0 then MH(q > m) else MHI(q > m)).
  resFrom1?m1.
  resFrom2?m2.
  resTo1!m.
  resTo2!m.
  basisTo1!y.
  basisTo2!y.
  basisToDealer!y.
  basisFrom2?y2.
  basisFrom1?y1.
  basisFromDealer?ya.
  (if ya ^ y1 ^ y2 ^ y = 0
    then secret!m1 ^ m2 ^ m ^ (ya & y1 ^ ya & y2 ^ ya & y ^ y1 & y2 ^ y1 & y ^ y2 & y).disc(q)
    else disc(q))

proc QSSSpec3[qAlice, qR1, qR2, qR3](secret: chan bit, secret1: chan bit, secret2: chan bit, secret3: chan bit) :=
  MRandBit(> s).MRandBit(> keep).
  (if keep = 0
    then disc(qAlice, qR1, qR2, qR3)
    else ((secret!s.disc()) || (secret1!s.disc()) || (secret2!s.disc()) || (secret3!s.disc())
           || disc(qAlice, qR1, qR2, qR3)))

state GHZ := density 3 H(0).CNOT(0,1).CNOT(1,2)

state GHZ4 := density 4 H(0).CNOT(0,1).CNOT(1,2).CNOT(2,3)

start "honest" {
  density GHZ
  process (@QSSDealer[qb0](b1a, b2a, ba1, ba2, aout)
            || @QSSReceiver1[qb1](r12, r21, b21, b12, b1a, ba1, out1)
            || @QSSReceiver2[qb2](r12, r21, b21, b12, b2a, ba2, out2)
          ) \ r12 \ r21 \ b12 \ b21 \ b1a \ b2a \ ba1 \ ba2
}

start "spec" {
  density GHZ
  process @QSSSpec[qb0, qb1, qb2](aout, out1, out2)
}

start "honest3" {
  density GHZ4
  process (@QSSDealer3[qb0](b1a, b2a, b3a, ba1, ba2, ba3, aout)
            || @QSS3Receiver1[qb1](r12, r13, r21, r31, b31, b21, b12, b13, b1a, ba1, out1)
            || @QSS3Receiver2[qb2](r12, r21, r23, r32, b32, b21, b23, b2a, b12, ba2, out2)
            || @QSS3Receiver3[qb3](r13, r23, r31, r32, b31, b32, b3a, b23, b13, ba3, out3)
          ) \ r12 \ r13 \ r21 \ r23 \ r31 \ r32 \ b12 \ b13 \ b21 \ b23 \ b31 \ b32
            \ b1a \ b2a \ b3a \ ba1 \ ba2 \ ba3
}

start "spec3" {
  density GHZ4
  process @QSSSpec3[qb0, qb1, qb2, qb3](aout, out1, out2, out3)
}
